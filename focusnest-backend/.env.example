# ==========================================
# FocusNest Backend Environment Configuration
# ==========================================

# ── Database Configuration ──
# Option 1: Full Connection String (Recommended for Cloud Database e.g., Supabase, Neon, Render Postgres, TiDB Cloud, Aiven)
# PostgreSQL example: postgresql://user:password@ep-sample-123.us-east-2.aws.neon.tech/focusnest?sslmode=require
# MySQL example: mysql+pymysql://user:password@host:3306/focusnest
DATABASE_URL=

# Option 2: Individual MySQL Parameters (Used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=focusnest

# ── Security & Authentication ──
SECRET_KEY=generate_a_secure_random_32_character_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Frontend & CORS ──
# Comma-separated list of allowed frontend URLs (e.g., https://focusnest.vercel.app,http://localhost:3000)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000
ALLOW_ALL_CORS=false

# ── AI Features (Google Gemini API) ──
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Quotes API ──
# Get your free key at: https://api-ninjas.com/api/quotes
API_NINJAS_KEY=your_api_ninjas_key_here

# ── Email Service (For Password Reset) ──
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=noreply@focusnest.app
MAIL_FROM_NAME=FocusNest
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
